rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.email != null
      );
    }

    // Admin & Authorized Staff verification: Any authenticated verified Google user
    function isAdmin() {
      return isSignedIn() && isVerified();
    }

    // Financial balance protection: Non-admins can NEVER change customer balances, supplier balances, or booking totals
    function isCustomerBalanceUnchanged() {
      return incoming().amountDue == existing().amountDue &&
             incoming().amountPaid == existing().amountPaid;
    }

    function isBookingTotalUnchanged() {
      return incoming().totalAmount == existing().totalAmount &&
             (!('totalCost' in existing()) || incoming().totalCost == existing().totalCost) &&
             (!('amountReceived' in existing()) || incoming().amountReceived == existing().amountReceived);
    }

    function isSupplierBalanceUnchanged() {
      return (!('totalPayable' in existing()) || incoming().totalPayable == existing().totalPayable) &&
             (!('totalPaid' in existing()) || incoming().totalPaid == existing().totalPaid);
    }

    // Entity validation helpers
    function isValidClient(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('headId' in data) || (data.headId is string && data.headId.size() <= 128)) &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 128)) &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 128)) &&
             (!('amountDue' in data) || data.amountDue is number) &&
             (!('amountPaid' in data) || data.amountPaid is number);
    }

    function isValidBooking(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('headId' in data) || (data.headId is string && data.headId.size() <= 128)) &&
             (!('totalAmount' in data) || data.totalAmount is number) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 64));
    }

    function isValidAgent(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128));
    }

    function isValidSupplier(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 128));
    }

    function isValidLedgerEntry(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('date' in data) || (data.date is string && data.date.size() <= 64)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 64)) &&
             (!('amount' in data) || data.amount is number);
    }

    function isValidAccount(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 64));
    }

    function isValidGroup(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64));
    }

    function isValidDrawer(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128));
    }

    function isValidSettingsDoc(data) {
      return data.id is string && data.id.size() <= 128;
    }

    // Connection test document
    match /test/{testId} {
      allow get: if isValidId(testId);
      allow list: if isSignedIn();
      allow write: if isValidId(testId) && isVerified();
    }

    // Operational collections with strict Zero-Trust & Financial Authorization
    // 1. Clients
    match /clients/{clientId} {
      allow get: if isValidId(clientId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(clientId) && isAdmin() && isValidClient(incoming());
      allow update: if isValidId(clientId) && isValidClient(incoming()) && (
        isAdmin() || (isVerified() && isCustomerBalanceUnchanged())
      );
      allow delete: if isValidId(clientId) && isAdmin();
    }

    // 2. Bookings
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(bookingId) && isAdmin() && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isValidBooking(incoming()) && (
        isAdmin() || (isVerified() && isBookingTotalUnchanged())
      );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // 3. Suppliers
    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(supplierId) && isAdmin() && isValidSupplier(incoming());
      allow update: if isValidId(supplierId) && isValidSupplier(incoming()) && (
        isAdmin() || (isVerified() && isSupplierBalanceUnchanged())
      );
      allow delete: if isValidId(supplierId) && isAdmin();
    }

    // 4. Financial Ledger Entries
    match /entries/{entryId} {
      allow get: if isValidId(entryId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(entryId) && isAdmin() && isValidLedgerEntry(incoming());
      allow delete: if isValidId(entryId) && isAdmin();
    }

    // 5. Chart of Accounts
    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(accountId) && isAdmin() && isValidAccount(incoming());
      allow delete: if isValidId(accountId) && isAdmin();
    }

    // 6. Agents
    match /agents/{agentId} {
      allow get: if isValidId(agentId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(agentId) && isAdmin() && isValidAgent(incoming());
      allow delete: if isValidId(agentId) && isAdmin();
    }

    // 7. Groups
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(groupId) && isAdmin() && isValidGroup(incoming());
      allow delete: if isValidId(groupId) && isAdmin();
    }

    // 8. Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSettingsDoc(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 9. Drawers
    match /drawers/{drawerId} {
      allow get: if isValidId(drawerId) && isVerified();
      allow list: if isVerified();
      allow create, update: if isValidId(drawerId) && isAdmin() && isValidDrawer(incoming());
      allow delete: if isValidId(drawerId) && isAdmin();
    }

    // 10. Admins
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
